{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personal LAN development workspace inventory \u2014 not release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationLabel",
    "operatorOsUser",
    "pgDatabase",
    "pgAppRole",
    "pgMigratorRole",
    "pgBackupRole",
    "deploymentId",
    "organizationId",
    "pgSocketPath",
    "tlsCertPath",
    "tlsKeyPath",
    "lanCaBundlePath",
    "schemaVersion",
    "purpose",
    "profile",
    "publicBaseUrl",
    "allowedOrigins",
    "bindAddress",
    "pgPort",
    "releaseContacts",
    "backupTarget",
    "developmentConfigReady",
    "releaseReady",
    "pending",
    "notes"
  ],
  "properties": {
    "organizationLabel": {
      "type": "string",
      "minLength": 1
    },
    "operatorOsUser": {
      "type": "string",
      "minLength": 1
    },
    "pgDatabase": {
      "type": "string",
      "minLength": 1
    },
    "pgAppRole": {
      "type": "string",
      "minLength": 1
    },
    "pgMigratorRole": {
      "type": "string",
      "minLength": 1
    },
    "pgBackupRole": {
      "type": "string",
      "minLength": 1
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "pgSocketPath": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "tlsCertPath": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "tlsKeyPath": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "lanCaBundlePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "schemaVersion": {
      "const": 1
    },
    "purpose": {
      "const": "PERSONAL_DEVELOPMENT_FIXTURE"
    },
    "profile": {
      "const": "LAN_OFFLINE"
    },
    "publicBaseUrl": {
      "type": "string",
      "pattern": "^https://localhost:([1-9][0-9]{0,4})$"
    },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": {
          "$data": "/publicBaseUrl"
        }
      }
    },
    "bindAddress": {
      "const": "127.0.0.1"
    },
    "pgPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "releaseContacts": {
      "type": "null"
    },
    "backupTarget": {
      "type": "null"
    },
    "developmentConfigReady": {
      "const": false
    },
    "releaseReady": {
      "const": false
    },
    "pending": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "pgAppRole": {
            "const": {
              "$data": "/pgMigratorRole"
            }
          }
        },
        "required": [
          "pgAppRole",
          "pgMigratorRole"
        ]
      }
    },
    {
      "not": {
        "properties": {
          "pgAppRole": {
            "const": {
              "$data": "/pgBackupRole"
            }
          }
        },
        "required": [
          "pgAppRole",
          "pgBackupRole"
        ]
      }
    },
    {
      "not": {
        "properties": {
          "pgMigratorRole": {
            "const": {
              "$data": "/pgBackupRole"
            }
          }
        },
        "required": [
          "pgMigratorRole",
          "pgBackupRole"
        ]
      }
    }
  ]
}
