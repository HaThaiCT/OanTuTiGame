{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*",
    "docs/specs/**/*",
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "bots/**/*"
  ]
}
