{
  "name": "oantuti-arena-specs",
  "version": "1.0.0",
  "description": "Specification package and automated schema validation harness for OanTuTi Arena Battlecode platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:specs": "vitest run tests/specs-validation.test.ts",
    "test:proto": "vitest run tests/proto-compile.test.ts",
    "test:engine": "vitest run packages/engine",
    "test:runner": "vitest run packages/runner",
    "test:protocol": "vitest run packages/protocol",
    "test:web": "vitest run packages/web",
    "test:server": "vitest run packages/server",
    "test:load": "tsx tests/load/websocket-load.ts",
    "match:play": "tsx packages/runner/bin/run-match.ts",
    "build:wasm-verifier": "bash deploy/linux/build-wasm-verifier.sh",
    "measure:capacity": "tsx deploy/linux/capacity-probe.ts",
    "soak:probe": "tsx deploy/linux/soak-probe.ts",
    "demo:seed": "tsx deploy/linux/dev-demo.ts seed",
    "demo:status": "tsx deploy/linux/dev-demo.ts status",
    "demo:login": "tsx deploy/linux/dev-demo.ts login",
    "demo:accounts": "tsx deploy/linux/dev-demo.ts accounts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "protobufjs": "^7.4.0",
    "ts-proto": "2.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
