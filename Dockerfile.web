FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json tsconfig.json ./
COPY packages/engine/package.json ./packages/engine/
COPY packages/protocol/package.json ./packages/protocol/
COPY packages/runner/package.json ./packages/runner/
COPY packages/server/package.json ./packages/server/
COPY packages/web/package.json ./packages/web/
RUN npm ci
COPY packages/ ./packages/
# Next rewrites are resolved at build time; the service name is stable in both installations.
ENV API_BASE=http://server:3001
RUN npm run build --workspace=@oantuti/web

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 API_BASE=http://server:3001
COPY --from=builder --chown=node:node /app/packages/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/packages/web/.next/static ./packages/web/.next/static
COPY --from=builder --chown=node:node /app/packages/web/public ./packages/web/public
USER node
EXPOSE 3000
CMD ["node", "packages/web/server.js"]
